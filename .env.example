# Copy to .env and adjust. All variables are optional; defaults shown.

# Directory containing input point clouds / bathymetry (CSV with x,y,z[,class], .npy, or .las/.laz)
REEF_DATA_DIR=data/sample

# Directory where results (metrics.json, rasters, figures) are written
REEF_OUTPUT_DIR=outputs

# DEM cell size in metres
REEF_DEM_RESOLUTION=0.5

# Statistical outlier removal: neighbours considered, and std-dev multiplier
REEF_OUTLIER_K=8
REEF_OUTLIER_STD=3.0

# Gap filling: max distance (in cells) to nearest-neighbour fill empty DEM cells
REEF_MAX_FILL_CELLS=3

# Moving-window size (cells, odd) for local rugosity / complexity maps
REEF_WINDOW_CELLS=5

# Level of detection (metres) for depth change detection; smaller changes are ignored
REEF_LOD_M=0.15

# Number of classes for OBIA clustering
REEF_OBIA_CLASSES=4
# Minimum object size (cells) kept by OBIA
REEF_OBIA_MIN_CELLS=12

# Python logging level
REEF_LOG_LEVEL=INFO
